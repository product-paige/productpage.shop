{
  "name": "Collection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Collection name (e.g., 'Summer Essentials', 'Holiday Gifts')"
    },
    "description": {
      "type": "string",
      "description": "Collection description"
    },
    "image_url": {
      "type": "string",
      "description": "Collection cover image"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pin to top of list"
    }
  },
  "required": [
    "name"
  ]
}